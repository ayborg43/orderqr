# Copy to Dokploy's Environment tab (never commit a real .env).
SESSION_SECRET=change-me-to-a-long-random-string
# Platform super admin login for /superadmin (leave blank to disable it):
SUPERADMIN_USER=owner
SUPERADMIN_PASSWORD=change-me-super-admin-password
POSTGRES_PASSWORD=change-me-letters-and-numbers-only
PUBLIC_BASE_URL=https://chopdesk.propertypadi.com
# Staff logins are created per restaurant at signup — there are no global/default accounts.
# Optional: POSTGRES_USER=orderqr  POSTGRES_DB=orderqr
# Set automatically by the Dockerfile / compose file:
# NODE_ENV=production  PORT=3000  DATA_DIR=/app/data  TRUST_PROXY=1
# DATABASE_URL=postgres://<user>:<password>@db:5432/<db>  (wired by compose)
# Optional tuning (defaults shown):
# TRUST_PROXY=1            proxy hops in front of the app (2 if Cloudflare + Traefik)
# APP_TIMEZONE=Africa/Lagos  zone for printed invoices and receipts
# KEEP_ALIVE_MS=65000      keep idle connections open longer than your proxy does
# SIGNUP_PER_HOUR=5        new restaurants per address per hour
# STREAMS_PER_IP_RESTAURANT=300  STREAMS_PER_IP=600  MAX_STREAMS=5000
